{
  "name": "deep-real-estate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Deep Real Estate — React site (ui/) plus the serverless API behind the owner admin panel (api/).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "hash-password": "node scripts/hash-password.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "typecheck:api": "tsc -p tsconfig.json --noEmit",
    "selfcheck": "tsc -p tsconfig.json --noEmit false --outDir .selfcheck --declaration false && node scripts/selfcheck.mjs",
    "dev:build-api": "tsc -p tsconfig.json --noEmit false --outDir .local-api --declaration false",
    "dev:local": "npm run dev:build-api && node scripts/dev-server.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vercel/node": "^5.0.0",
    "typescript": "^5.7.0"
  }
}
